# Rinomina questo file in .env e inserisci le tue credenziali.
# NON committare il file .env su GitHub.

# Ottieni le API key su: https://testnet.binance.vision/
BINANCE_TESTNET_API_KEY=inserisci_qui_la_tua_api_key
BINANCE_TESTNET_SECRET=inserisci_qui_il_tuo_secret

# Telegram (opzionale) — per ricevere notifiche su trade ed errori
# 1. Crea un bot su @BotFather e copia il token
# 2. Avvia il bot, poi usa https://api.telegram.org/bot<TOKEN>/getUpdates per trovare il chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
